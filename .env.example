NODE_ENV=development
PORT=3001

DB_HOST=your-project-pooler.supabase.com
DB_PORT=6543
DB_DATABASE=postgres
DB_USERNAME=postgres.your-project-ref
DB_PASSWORD=replace_with_database_password
DB_SSL=true
DB_POOL_SIZE=10

JWT_SECRET=replace_with_random_secret_at_least_64_characters_long
JWT_REFRESH_SECRET=replace_with_another_random_secret_at_least_64_characters_long
JWT_ACCESS_EXPIRATION=8h
JWT_REFRESH_EXPIRATION=7d

CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-production-domain.vercel.app
COOKIE_SAMESITE=strict
COOKIE_SECURE=false

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace_with_publishable_key
SUPABASE_SECRET_KEY=replace_with_server_side_secret_key
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_STORAGE_BUCKET=transaction-invoices

CASHTRACKER_DASHBOARD_CACHE_TTL=300
CASHTRACKER_MAX_REPORT_MONTHS=18
